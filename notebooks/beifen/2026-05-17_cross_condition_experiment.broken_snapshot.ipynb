   "source": [
    "# 闂佺儵鏅╅崰姘枔閹达附鏅柛锔绘rpose闂? 闁?3.2 闂佺厧鎼崐璇测枔閹寸姷纾奸柟鎯ь嚟娴滎垶鏌涚€ｎ偉澹橀柛娆忕箳娴狅箓鍩€椤掆偓鏁堥柛銉ｅ妷閸嬫挻瀵煎▎鎴狀槷濡ょ姷鍋為崕鑲╂椤撱垹绀?3.3.1 / 3.3.2 闂佹眹鍔岀€氼剟顢氶澶规帡寮幐搴ｎ洯闁荤偞绋忛崝濠囧焵椤戣法绠皀",
    "# 闁哄鐗婇幐鎼佸矗閸℃稒鏅柛锔芥崟puts闂? `stage3_results`闂侀潧妫斿姊age3_all_test_detail_df`闂侀潧妫斿姊age3_all_summary_df`闂侀潧妫斿姊age3_experiment_specs`闂侀潧妫斿姊age3_test_domains`闂侀潧妫旂换鎭?,
    "# 闁哄鐗婇幐鎼佸吹椤撱垺鏅柛锔绘Бtputs闂? 3.3.1 闂佹眹鍔岀€氼叀鍟梺鎼炲妼椤戝懎霉閹邦喒鍋撶憴鍕妞ゆ洦鍠栬闁哄倹瀵х粋鍫ユ煥?.3.2 闂佹眹鍔岀€氼剟宕规惔锝囧暗閻犲洤寮堕悵銈夋煕閵夈儲鎯堥柣锝呭⒔閳ь兛绲婚～澶愭儊椤曗偓瀹曞爼骞橀崨顖氳€挎繛瀵稿О閸庡崬顕ｉ悜鑺ュ殣闁靛鍎遍崣鈩冩叏閻熺増澶勯柍褜鍓氬Σ鎺楀Υ閸愵喖违濞ｅ洦鎮?,
    "\n",
    "comparison_metric = \"balanced_accuracy\"\n",
    "\n",
    "print(\"All experiments summary (model-level):\")\n",
    "display(stage3_all_summary_df.sort_values([\"model_name\", \"experiment\"]))\n",
    "\n",
    "print(\"All experiments detail (model x test-domain):\")\n",
    "display(stage3_all_test_detail_df.sort_values([\"model_name\", \"experiment\", \"test_domain\"]))\n",
    "\n",
    "# 3.3.1: 闂佹悶鍎遍幖顐︽偩閻愵剛鈻旈柍褜鍓涚划鏂款吋閸狅絼绶氬畷鍦偓锝呭缁€澶愭倵娴ｅ喚娼愰柣锔诲枟缁嬪顓奸崨顔尖偓閬嶆煟濡ゅ啯鍤€缂佽埖绋撶槐鎺楀礋椤愶絽鈧倝鏌涢敂鍝勫缂佹顦靛畷銉т沪閸撗佸仦闁荤姴娲﹀ú鏍偂濞嗘劗鈻斿┑鐘插閻ｉ亶鏌℃担鍝ュ闁诲繐顦垫俊瀛樼┍閹?,
    "for model_name in ACTIVE_MODEL_NAMES:\n",
    "    model_df = stage3_all_test_detail_df.loc[stage3_all_test_detail_df[\"model_name\"] == model_name].copy()\n",
    "    if model_df.empty:\n",
    "        continue\n",
    "\n",
    "    pivot = model_df.pivot(index=\"experiment\", columns=\"test_domain\", values=comparison_metric)\n",
    "    pivot = pivot.reindex(index=[spec.name for spec in stage3_experiment_specs], columns=stage3_test_domains)\n",
    "    print(f\"\\n3.3.1 model = {model_name} | metric = {comparison_metric}\")\n",
    "    display(pivot)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(10, 5))\n",
    "    matrix = pivot.to_numpy(dtype=float)\n",
    "    im = ax.imshow(matrix, cmap=\"Blues\", vmin=0, vmax=1, aspect=\"auto\")\n",
    "    ax.set_title(f\"3.3.1 Fixed model = {model_name} | {comparison_metric}\")\n",
    "    ax.set_xticks(np.arange(len(stage3_test_domains)))\n",
    "    ax.set_xticklabels(stage3_test_domains, rotation=20, ha=\"right\")\n",
    "    ax.set_yticks(np.arange(len(stage3_experiment_specs)))\n",
