    "# 闂佺儵鏅╅崰姘枔閹达附鏅柛锔绘rpose闂? 闂佺懓鐏氶幐绋跨暤?exp_07 闂侀潻璐熼崝宀勫箖鎼淬劎宓侀柤鍝ユ暩閵堟挳鎮归崶銊︾婵炲绠撻弫宥夊捶?30+F130A+F130C_test闂佹寧绋戦ˇ顔剧箔閸岀偞鍎嶉柛鏇ㄤ簽閻熷繑淇婇妞诲亾瀹曞洠鍋撳畡鎳婂湱鈧綆鍘惧Σ鍝ョ磽娴ｈ灏伴柣蹇擃樀婵″瓨绌遍幖?,
    "# 闁哄鐗婇幐鎼佸矗閸℃稒鏅柛锔芥崟puts闂? stage3_all_test_detail_df闂佹寧绋戦悧鍡涙偂濞嗘垹妫憸搴ｂ偓鍨哺瀵粙宕舵搴ｎ槴闂侀潧妫旀径鐒ge3_all_misclassified_df闂佹寧绋戦悧鎰邦敋閵堝绀嗛柕鍫濇婢瑰鏌￠崼顐㈠婵″弶鍨圭槐鎺楀幢椤撶姷顦梺闈涙缁绘仒",
    "# 闁哄鐗婇幐鎼佸吹椤撱垺鏅柛锔绘Бtputs闂? 婵炴垶鎸搁ˇ鎷屽暞闂佹悶鍔岄鍛耿椤忓牆瑙﹂柛顐ｇ箚鐎氭瑦绻涢弶鎴創闁伙富鍨跺鍧楀幢閺囩姷鎲梺姹囧妼鐎氼參鎯囪ぐ鎺戠畱缂備焦锚閻﹀綊鏌″鍛┛闁靛棗鍟存俊瀛樼┍閹?,
    "\n",
    "target_experiment = \"exp_07_train_F130_F130A_F130C\"\n",
    "domain_order = [\"F130\", \"F130A\", \"F130C\"]\n",
    "\n",
    "detail_df = stage3_all_test_detail_df.loc[\n",
    "    (stage3_all_test_detail_df[\"experiment\"] == target_experiment)\n",
    "    & (stage3_all_test_detail_df[\"test_domain\"].isin(domain_order))\n",
    "].copy()\n",
    "\n",
    "if detail_df.empty:\n",
    "    raise ValueError(f\"No rows found for {target_experiment} on domains={domain_order}\")\n",
    "\n",
    "rows = []\n",
    "for model_name, sub in detail_df.groupby(\"model_name\", dropna=False):\n",
    "    tn = int(sub[\"tn\"].sum())\n",
    "    fp = int(sub[\"fp\"].sum())\n",
    "    fn = int(sub[\"fn\"].sum())\n",
    "    tp = int(sub[\"tp\"].sum())\n",
    "\n",
    "    total = tn + fp + fn + tp\n",
    "    acc = (tn + tp) / total if total > 0 else float(\"nan\")\n",
    "    recall_pos = tp / (tp + fn) if (tp + fn) > 0 else float(\"nan\")\n",
    "    recall_neg = tn / (tn + fp) if (tn + fp) > 0 else float(\"nan\")\n",
    "    bal_acc = 0.5 * (recall_pos + recall_neg) if not (np.isnan(recall_pos) or np.isnan(recall_neg)) else float(\"nan\")\n",
    "    precision_pos = tp / (tp + fp) if (tp + fp) > 0 else float(\"nan\")\n",
    "    f1_pos = (2 * precision_pos * recall_pos / (precision_pos + recall_pos)) if (precision_pos + recall_pos) > 0 else float(\"nan\")\n",
    "\n",
    "    # ROC/PR AUC 闂佸搫鍟版慨鐢垫兜閸洘鍋ㄩ弶鍫涘姀缁屾寧绻涢敐鍛棤闁绘挴鏅犲濂稿礂缁嬭法鑸归梺鍝勭Т閵堟悂宕崇粙娆惧殘闁绘艾顕獮銏ゅ级閳哄倻鎳囬柛锝囧厴閺屽矂宕堕埡鍌涙闂佸搫绉归弨鍗烇耿娴煎瓨鐓傞煫鍥ㄦ尭椤綁鏌℃径濠傛殺缂佽瀛╃€靛ジ宕楅懖鈺傝弴闂佽鍓氶惇褰掑焵椤戣法绠皀",
    "    support = (sub[[\"tn\", \"fp\", \"fn\", \"tp\"]].sum(axis=1)).to_numpy(dtype=float)\n",
    "    roc_auc_weighted = float(np.average(sub[\"roc_auc\"].to_numpy(dtype=float), weights=support)) if support.sum() > 0 else float(\"nan\")\n",
    "    pr_auc_weighted = float(np.average(sub[\"pr_auc\"].to_numpy(dtype=float), weights=support)) if support.sum() > 0 else float(\"nan\")\n",
    "\n",
    "    rows.append(\n",
    "        {\n",
    "            \"experiment\": target_experiment,\n",
    "            \"test_set\": \"F130+F130A+F130C_test\",\n",
    "            \"model_name\": model_name,\n",
    "            \"display_name\": sub[\"display_name\"].iloc[0],\n",
    "            \"threshold\": float(sub[\"threshold\"].iloc[0]),\n",
    "            \"accuracy\": acc,\n",
    "            \"balanced_accuracy\": bal_acc,\n",
    "            \"recall_pos\": recall_pos,\n",
    "            \"precision_pos\": precision_pos,\n",
    "            \"f1_pos\": f1_pos,\n",
    "            \"roc_auc_weighted\": roc_auc_weighted,\n",
    "            \"pr_auc_weighted\": pr_auc_weighted,\n",
    "            \"tn\": tn,\n",
    "            \"fp\": fp,\n",
    "            \"fn\": fn,\n",
    "            \"tp\": tp,\n",
    "            \"n_domains_merged\": int(sub[\"test_domain\"].nunique()),\n",
    "        }\n",
    "    )\n",
    "\n",
    "exp07_merged_test_results_df = pd.DataFrame(rows).sort_values(\"model_name\").reset_index(drop=True)\n",
    "display(exp07_merged_test_results_df)\n"
   ]
